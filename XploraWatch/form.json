{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "WardID",
            "caption": "Watch ID (set by the configurator)"
        },
        {
            "type": "NumberSpinner",
            "name": "UpdateInterval",
            "caption": "Update interval",
            "suffix": "seconds",
            "minimum": 60
        },
        {
            "type": "NumberSpinner",
            "name": "LocateRequestAge",
            "caption": "Request a new location when the last one is older than (0 = never)",
            "suffix": "minutes",
            "minimum": 0
        },
        {
            "type": "ExpansionPanel",
            "caption": "Home",
            "items": [
                {
                    "type": "Label",
                    "caption": "Optional: with a home location the variables \"At home\" and \"Distance to home\" are created."
                },
                {
                    "type": "CheckBox",
                    "name": "UseSymconLocation",
                    "caption": "Use the location of Symcon (Location Control)"
                },
                {
                    "type": "SelectLocation",
                    "name": "HomeLocation",
                    "caption": "Own home location (if the location of Symcon is not used)"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "HomeAddress",
                            "caption": "Address (street, town)",
                            "width": "400px"
                        },
                        {
                            "type": "Button",
                            "caption": "Find",
                            "onClick": "echo XPLW_FindLocation($id, 'HomeLocation', $HomeAddress);"
                        }
                    ]
                },
                {
                    "type": "NumberSpinner",
                    "name": "HomeRadius",
                    "caption": "Home radius",
                    "suffix": "m",
                    "minimum": 0
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Second place",
            "items": [
                {
                    "type": "Label",
                    "caption": "Optional: a second place such as school, work or a second home. With a location the variables \"At <name>\" and \"Distance to <name>\" are created."
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Place2Name",
                    "caption": "Name (e.g. School, Work, Second home)"
                },
                {
                    "type": "SelectLocation",
                    "name": "Place2Location",
                    "caption": "Location of the second place"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "Place2Address",
                            "caption": "Address (street, town)",
                            "width": "400px"
                        },
                        {
                            "type": "Button",
                            "caption": "Find",
                            "onClick": "echo XPLW_FindLocation($id, 'Place2Location', $Place2Address);"
                        }
                    ]
                },
                {
                    "type": "NumberSpinner",
                    "name": "Place2Radius",
                    "caption": "Radius of the second place",
                    "suffix": "m",
                    "minimum": 0
                }
            ]
        },
        {
            "type": "CheckBox",
            "name": "ShowTile",
            "caption": "Create status tile (HTML box for the tile visualization)"
        },
        {
            "type": "CheckBox",
            "name": "TileMap",
            "caption": "Map of the location as background of the status tile (Esri)"
        },
        {
            "type": "Select",
            "name": "TileTheme",
            "caption": "Design of the status tile",
            "options": [
                {
                    "caption": "Automatic (light/dark mode of the device)",
                    "value": 0
                },
                {
                    "caption": "Dark",
                    "value": 1
                },
                {
                    "caption": "Light",
                    "value": 2
                }
            ]
        },
        {
            "type": "CheckBox",
            "name": "ShowMap",
            "caption": "Create map variable (OpenStreetMap)"
        },
        {
            "type": "ExpansionPanel",
            "caption": "Location history",
            "items": [
                {
                    "type": "Label",
                    "caption": "Stores the locations in the instance and shows them per day on a map with replay. The page is delivered by a WebHook with a random token."
                },
                {
                    "type": "CheckBox",
                    "name": "ShowHistory",
                    "caption": "Record location history"
                },
                {
                    "type": "NumberSpinner",
                    "name": "HistoryDays",
                    "caption": "Keep history for",
                    "suffix": "days",
                    "minimum": 1,
                    "maximum": 60
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Update now",
            "onClick": "XPLW_Update($id);"
        },
        {
            "type": "Button",
            "caption": "Request location from watch",
            "onClick": "echo XPLW_RequestLocation($id) ? 'OK' : 'Error';"
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "inactive",
            "caption": "No watch ID configured"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Request failed, see debug output and the cloud instance"
        }
    ]
}